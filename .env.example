# Copy to .env before running `npm run build` / `npm run dev`.
# Baked into the bundle at build time — this is the DEFAULT backend a built
# widget.js talks to. Set this to your local backend for local builds, or to
# the deployed backend's real URL for a production build.
LEADRYZE_API_BASE_URL=http://localhost:5000/api/v1

# NOTE: the built widget.js also accepts a per-embed runtime override via a
# `data-api-url` attribute on the <script> tag — this lets ONE already-built
# bundle (e.g. the live, deployed widget.js) be pointed at a DIFFERENT backend
# for a specific test page, with no rebuild needed:
#   <script src=".../loader.js" data-widget-key="wgt_xxx"
#           data-api-url="http://localhost:5000/api/v1" async></script>
# Omit data-api-url and it falls back to the LEADRYZE_API_BASE_URL baked in
# above. This is the mechanism to use for local<->live UAT testing.
